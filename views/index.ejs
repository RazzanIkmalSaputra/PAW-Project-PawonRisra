<%- include('partials/head', { judul: judul }) %>
<body class="bg-amber-50 text-gray-900 font-sans antialiased">

  <header class="max-w-5xl mx-auto px-6 py-6 flex items-center justify-between">
    <a href="/" class="text-xl font-extrabold tracking-tight text-amber-800"><%= namaToko %></a>
    <nav class="flex gap-5 text-sm font-semibold">
      <a href="#produk" class="hover:underline focus-visible:underline">Produk</a>
      <a href="/api/produk" class="hover:underline focus-visible:underline">API produk</a>
      <a href="/api/status" class="hover:underline focus-visible:underline">API status</a>
    </nav>
  </header>

  <main>
    <!-- Hero / Bagian Utama -->
    <section class="max-w-5xl mx-auto px-6 pt-10 pb-20 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold leading-[1.05] tracking-tight text-amber-900">
          Cemilan gurih khas Pawon Risra, renyah di setiap gigitan.
        </h1>
        <p class="mt-6 text-lg max-w-md text-gray-700">
          Keripik singkong pilihan dan kacang bawang gurih berkualitas, diolah higienis untuk menemani hari-harimu.
        </p>
        <a href="#produk"
           class="inline-block mt-8 bg-amber-700 text-white font-semibold rounded-md px-6 py-3 hover:bg-amber-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700">
          Lihat produk
        </a>
      </div>

      <!-- Kotak Status API / Mockup -->
      <div class="bg-gray-900 text-amber-100 rounded-lg p-6 font-mono text-sm shadow-lg">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold">GET /api/status</span>
          <span class="flex items-center gap-2">
            <span id="status-dot" class="h-2.5 w-2.5 rounded-full bg-gray-500"></span>
            <span id="status-label">Menghubungi server</span>
          </span>
        </div>
        <pre id="status-output" class="whitespace-pre-wrap break-words text-amber-400 min-h-[8rem]">...</pre>
      </div>
    </section>

    <!-- Produk Pawon Risra -->
    <section id="produk" class="max-w-5xl mx-auto px-6 pb-20 scroll-mt-6">
      <h2 class="text-3xl font-extrabold tracking-tight text-amber-900">Produk Pawon Risra</h2>
      <p class="mt-2 text-gray-600">Data diambil langsung dari <code class="font-mono text-sm bg-amber-100 px-1 py-0.5 rounded text-amber-900">models/produkModel.js</code>.</p>

      <ul class="mt-8 divide-y divide-amber-200 border-y border-amber-200">
        <% produk.forEach(function (p) { %>
          <li class="py-5 flex items-start justify-between gap-6">
            <div>
              <h3 class="text-lg font-semibold text-gray-900"><%= p.nama %></h3>
              <p class="text-gray-600 max-w-md"><%= p.keunggulan %></p>
              <p class="mt-1 text-sm font-medium text-amber-800"><%= p.kategori %></p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-lg font-extrabold text-amber-900">Rp <%= p.harga.toLocaleString('id-ID') %></p>
              <p class="text-sm text-gray-500">Stok: Tersedia</p>
            </div>
          </li>
        <% }); %>
      </ul>
    </section>

    <!-- Chat UI terintegrasi -->
    <section class="max-w-5xl mx-auto px-6 pb-20">
      <h2 class="text-2xl font-extrabold tracking-tight text-amber-900 mb-4">Tanya Asisten AI</h2>
      <div class="chat-container bg-white p-4 rounded-lg shadow-md border border-amber-200">
        <div id="chat-box" style="height: 300px; overflow-y: scroll; border: 1px solid #e5e7eb; padding: 15px; margin-bottom: 10px; border-radius: 8px; background-color: #f9fafb;">
            <!-- Pesan akan muncul di sini -->
            <div style="margin-bottom: 8px;"><strong>AI:</strong> Halo! Ada yang ingin ditanyakan seputar produk Pawon Risra?</div>
        </div>
        <div style="display: flex; gap: 8px;">
            <input type="text" id="chat-input" placeholder="Tanya tentang keripik atau kacang..." class="form-control" style="flex: 1; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" />
            <button id="send-btn" class="btn btn-primary" style="background-color: #b45309; color: white; padding: 10px 20px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer;">Kirim</button>
        </div>
      </div>
    </section>

  </main>

  <script>
    // Logika API Status bawaan dari kodemu
    (async function () {
      const output = document.getElementById('status-output');
      const label = document.getElementById('status-label');
      const dot = document.getElementById('status-dot');

      try {
        const res = await fetch('/api/status');
        const data = await res.json();
        output.textContent = JSON.stringify(data, null, 2);
        label.textContent = 'Server berjalan';
        dot.className = 'h-2.5 w-2.5 rounded-full bg-amber-400 motion-safe:animate-pulse';
      } catch (err) {
        output.textContent = 'Gagal menghubungi /api/status. Pastikan server masih berjalan.';
        label.textContent = 'Tidak terhubung';
      }
    })();

    // Logika Integrasi Gemini AI
    document.addEventListener('DOMContentLoaded', () => {
      const chatBox = document.getElementById('chat-box');
      const chatInput = document.getElementById('chat-input');
      const sendBtn = document.getElementById('send-btn');

      // Fungsi untuk menambahkan pesan ke layar
      const appendMessage = (sender, text) => {
        const msgElement = document.createElement('div');
        msgElement.innerHTML = `<strong>${sender}:</strong> ${text}`;
        msgElement.style.marginBottom = '8px';
        msgElement.style.padding = '8px';
        msgElement.style.backgroundColor = sender === 'Kamu' ? '#fef3c7' : '#ffffff';
        msgElement.style.borderRadius = '6px';
        msgElement.style.border = '1px solid #e5e7eb';
        chatBox.appendChild(msgElement);
        chatBox.scrollTop = chatBox.scrollHeight; // Auto-scroll ke bawah
        return msgElement;
      };

      // Fungsi saat tombol kirim ditekan
      sendBtn.addEventListener('click', async () => {
        const message = chatInput.value.trim();
        if (!message) return;

        // Tampilkan pertanyaan user
        appendMessage('Kamu', message);
        chatInput.value = '';
        sendBtn.disabled = true;
        sendBtn.style.opacity = '0.5';

        // Tampilkan indikator loading
        const loadingMsg = appendMessage('AI', '<em>Sedang berpikir...</em>');

        try {
          // Kirim request ke backend endpoint /api/chat
          const response = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message })
          });
          
          const result = await response.json();
          
          // Tampilkan balasan AI
          if (result.success) {
            loadingMsg.innerHTML = `<strong>AI:</strong> ${result.data.reply}`;
          } else {
            loadingMsg.innerHTML = `<strong>AI (Error):</strong> <span style="color: red;">${result.message}</span>`;
          }
        } catch (error) {
          loadingMsg.innerHTML = `<strong>AI (Error):</strong> <span style="color: red;">Gagal terhubung ke server backend.</span>`;
        } finally {
          // Aktifkan kembali tombol kirim
          sendBtn.disabled = false;
          sendBtn.style.opacity = '1';
          chatInput.focus();
        }
      });

      // Handle tombol enter
      chatInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendBtn.click();
      });
    });
  </script>

<%- include('partials/footer') %>
</body>
</html>